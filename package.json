{
  "name": "neuriplo-ui",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:server",
    "dev:web": "npm --workspace @neuriplo-ui/web run dev",
    "dev:server": "npm --workspace @neuriplo-ui/server run dev",
    "typecheck": "npm-run-all typecheck:web typecheck:server typecheck:e2e",
    "typecheck:web": "npm --workspace @neuriplo-ui/web run typecheck",
    "typecheck:server": "npm --workspace @neuriplo-ui/server run typecheck",
    "typecheck:e2e": "npm --workspace @neuriplo-ui/e2e run typecheck",
    "build": "npm-run-all build:web build:server",
    "build:web": "npm --workspace @neuriplo-ui/web run build",
    "build:server": "npm --workspace @neuriplo-ui/server run build",
    "test": "npm-run-all test:web test:server",
    "test:web": "npm --workspace @neuriplo-ui/web run test",
    "test:server": "npm --workspace @neuriplo-ui/server run test",
    "test:e2e": "npm --workspace @neuriplo-ui/e2e run test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "npm-run-all": "^4.1.5"
  }
}
