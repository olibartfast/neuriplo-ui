NEURIPLO_INFER_BIN=/path/to/neuriplo-infer
HOST=127.0.0.1
PORT=5174
NEURIPLO_UI_BASE_URL=http://127.0.0.1:5173

# The dev and preview servers bind loopback. They proxy /api to an adapter that
# reads this machine's filesystem and spawns processes on it, so exposing them
# on a network is opt-in rather than the default.
# NEURIPLO_UI_HOST=0.0.0.0

# Optional adapter settings.
# NEURIPLO_UI_RUN_ROOT=/tmp/neuriplo-ui-runs
# NEURIPLO_UI_RUN_TIMEOUT_MS=300000
# NEURIPLO_UI_BROWSE_ROOT=/home/user
# NEURIPLO_UI_SOURCE_ROOT=/home/user/datasets
# Hosts a client-server endpoint may address. Defaults to loopback only.
# NEURIPLO_UI_REMOTE_ALLOW=gpu-box:8000,10.0.0.5
